# --- Instagram ---
# Your own Instagram login. Used only to read your own Saved collections
# via the unofficial instagrapi client (no official API exposes Saved
# Collections for any account type).
IG_USERNAME=
IG_PASSWORD=

# Name of the Saved collection to pull posts from.
IG_COLLECTION_NAME=music

# If Instagram challenges the login (very likely from a cloud IP), rerun
# with the verification code it emails/texts you, e.g.:
#   IG_CHALLENGE_CODE=123456 python src/main.py
IG_CHALLENGE_CODE=

# If your account has 2FA enabled, rerun with the code from your
# authenticator app/SMS, e.g.:
#   IG_2FA_CODE=123456 python src/main.py
IG_2FA_CODE=

# --- Spotify ---
# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the app (see README)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Target playlist: set the ID if you already have a playlist, OR set a
# name and the agent will create it if it doesn't exist yet.
SPOTIFY_PLAYLIST_ID=
SPOTIFY_PLAYLIST_NAME=Instagram Music Saves
